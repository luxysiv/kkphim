<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/bg_item"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"> <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp">

        <View
            android:id="@+id/imagePlaceholder"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#33FFFFFF"
            app:layout_constraintDimensionRatio="2:3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/titlePlaceholder1"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            android:background="#33FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imagePlaceholder" />

        <View
            android:layout_width="60dp"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:background="#33FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titlePlaceholder1" />

        <View
            android:layout_width="80dp"
            android:layout_height="10dp"
            android:layout_marginTop="10dp"
            android:background="#33FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titlePlaceholder1"
            android:layout_marginBottom="10dp"
            app:layout_goneMarginTop="20dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
