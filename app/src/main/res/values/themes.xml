<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.KKPhim" parent="Theme.MaterialComponents.DayNight.NoActionBar"> 
        <item name="colorPrimary">#E50914</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:statusBarColor">#E0E0E0</item> 
        <item name="android:navigationBarColor">#E0E0E0</item>

        <item name="android:enforceStatusBarContrast">true</item>
        <item name="android:enforceNavigationBarContrast">true</item>
        
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.KKPhim.Player" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

</resources>
